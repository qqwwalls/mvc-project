@model IEnumerable<mvc.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<table class="table table-striped table-bordered mt-3">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Slug</th>
            <th>URL</th>
            <th>Status</th>
            <th>Parent ID</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Slug</td>
                <td>@item.Url</td>
                <td>@(item.IsActive ? "Active" : "Inactive")</td>
                <td>@item.ParentId</td>
            </tr>
        }
    </tbody>
</table>
