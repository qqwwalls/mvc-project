@model mvc.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<h1>Delete Product</h1>
<h3 class="text-danger">Are you sure you want to delete this?</h3>

<div class="card shadow mt-4" style="max-width: 600px;">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name" style="max-height: 200px; object-fit: contain; background: #f8f9fa; padding: 10px;">
    }
    <div class="card-body">
        <h3 class="card-title">@Model.Name</h3>
        <h5 class="text-primary">@Model.Price.ToString("C")</h5>
        <p class="card-text">@Model.Description</p>
        <p class="card-text"><small class="text-muted">Stock Quantity: @Model.StockQty</small></p>
    </div>
    <div class="card-footer bg-white">
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
