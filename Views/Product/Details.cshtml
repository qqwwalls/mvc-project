@model mvc.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<h1>Product Details</h1>

<div class="card shadow mt-4" style="max-width: 600px;">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name" style="max-height: 400px; object-fit: contain; background: #f8f9fa; padding: 20px;">
    }
    <div class="card-body">
        <h3 class="card-title">@Model.Name</h3>
        <h5 class="text-primary">@Model.Price.ToString("C")</h5>
        <p class="card-text">@Model.Description</p>
        <p class="card-text"><small class="text-muted">Stock Quantity: @Model.StockQty</small></p>
    </div>
    <div class="card-footer bg-white">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
